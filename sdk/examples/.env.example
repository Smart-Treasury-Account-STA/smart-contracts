# Copy to .env and fill in real testnet secret keys before running the
# write examples (02, 03, 04, 05). Never commit a real .env file.
# Get keys with: stellar keys show <identity>

# The treasury's registered Signer::Delegated wallet (sta-testnet-factory-owner).
OWNER_SECRET_KEY=

# Any funded account that pays the network fee for prepared transactions.
# Can be the same as OWNER_SECRET_KEY.
FEE_SOURCE_SECRET_KEY=

# The intent_registry Executor identity (sta-testnet-relayer), for example 04.
RELAYER_SECRET_KEY=
